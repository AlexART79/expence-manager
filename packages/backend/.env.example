# Server
PORT=3000
NODE_ENV=development
DATABASE_URL=./data/app.db

# Session — must be at least 32 random characters in production
SESSION_SECRET=dev-secret-change-in-prod-32-chars!!

# URLs
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Google OAuth — from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_TO_CONSOLE=true
LOG_TO_FILE=false
LOG_DIR=logs/backend
